# Lume — environment variable names. Values live in Vercel (project root
# directory: `lume`) and in a gitignored `.env.local` for development.

# Supabase (shared with the root app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who may sign in (the single magic-link account)
LUME_ALLOWED_EMAIL=

# Shared secrets between Lume, telegram-inbox, DB triggers and the agent
LUME_ACTION_SECRET=
LUME_HOOK_SECRET=
# MCP server bearer token (32+ chars, openssl rand -hex 32). /api/mcp 401s without it.
LUME_MCP_TOKEN=
# MCP write tools: unset = read-only (default); internal = + group B; gated = + group C
LUME_MCP_WRITES=
# Optional: kinds lume_confirm_action may approve (ceiling in code: pause_campaign only)
LUME_MCP_CONFIRM_KINDS=
# Shared secret for Lume calling its own internal routes
LUME_INTERNAL_SECRET=

# Public base URL of this deployment (deep links, callbacks)
LUME_URL=
# Optional: where Lume calls itself (agent tools, sweeper). Default: the request origin
LUME_INTERNAL_URL=

# Third parties
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Client Slack app (3g; docs/lume/SLACK-CLIENT-SETUP.md). All four, or Slack
# stays "not configured". LUME_SLACK_TOKEN_KEY: 32 random bytes, base64 or hex
# (encrypts the clients' bot tokens; rotating it means clients reinstall).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
LUME_SLACK_TOKEN_KEY=

# Optional: the Instantly campaign instantly-rotate drains (same name and
# default as the edge function). The Rotate screen marks it as the rotator.
ROTATE_CAMPAIGN_ID=

# Opt-in for `npm run smoke:db` (read-only live row counts); shell only
# LUME_SMOKE=1

# Optional: agent model override (default claude-sonnet-5-5)
LUME_AGENT_MODEL=

# Optional: bookmarkable owner sign-in at /auth/key?k=<key> (no email). Leave empty to disable.
LUME_OWNER_KEY=

# Calendar → Linear (lib/adapters/linear.ts). Unset = tasks stay in Lume.
LINEAR_API_KEY=
# Optional, default GTM.
LINEAR_TEAM_KEY=

# Railway crawl worker (workers/crawl): PM-vs-vendor classifier
CRAWL_WORKER_URL=
CRAWL_WORKER_SECRET=

# Optional: notification channels, comma list of telegram,feed (default both)
ALERT_CHANNELS=

# Optional: Jina reader key for web page fetches (raises the free rate limit)
JINA_API_KEY=

# Optional: monthly Apify cap fallback in USD (default 29; Settings > Budget wins)
LUME_RESEARCH_APIFY_CAP_USD=

# Optional: GTM-15 F5Bot webhook secret (Apps Script → /api/webhooks/f5bot). Unset = the route 401s.
LUME_F5BOT_SECRET=

# GTM-19 Hiring Ops Signal: per-company PM check (Perplexity sonar). Unset = rows wait unchecked.
PERPLEXITY_API_KEY=
