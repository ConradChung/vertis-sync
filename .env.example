# Next.js app (Vercel / .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INSTANTLY_API_KEY=
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
# APIFY_ACTOR_ID: actor for app/api/validate/apify/start
APIFY_ACTOR_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_WEBHOOK_URL=
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Supabase edge-function secrets — NOT read from this file. Set them with
#   supabase secrets set NAME=value --project-ref rcfrumrbauwvyzfebxck
# Listed here so the full set is in one place.
#
# TELEGRAM_BOT_TOKEN=            owner notifications + gate buttons
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=       telegram-inbox webhook check
# MAILTESTER_API_KEY=            email-validator
# APIFY_API_TOKEN=               HNWI pipeline, company-research
# INSTANTLY_API_KEY=             instantly-push / instantly-rotate
# ROTATE_CAMPAIGN_ID=            optional; instantly-rotate's campaign (has a default)
# ANTHROPIC_API_KEY=             edge copy: operating-city-enricher, company-research (Haiku extraction)
# LUME_RESEARCH_APIFY_CAP_USD=   optional; company-research monthly Apify cap in USD (default 29)
# PERPLEXITY_API_KEY=            operating-city-enricher
# CONNECTOR_OS_API_KEY=          contact-email-finder / hnwi-email-finder
# SLACK_BOT_TOKEN=               slack-inbox / telegram-inbox
# SLACK_SIGNING_SECRET=          slack-inbox request verification
# LEADSFRIDAY_BASE_URL=          optional override for leadsfriday-order
#
# Job search pipeline (docs/plans/2026-10-09-jobsearch-pipeline-design.md)
# GOOGLE_SERVICE_ACCOUNT_JSON=   full JSON key; share the sheet with its client_email as Editor
# JOBSEARCH_SHEET_ID=1wjvpjyX2g7UUkjgeOXRtPEb7-s4MQfmPOgikalpthcs
# APOLLO_API_KEY=                x-api-key for POST /api/v1/accounts
# LEADSFRIDAY_API_TOKEN=         bearer token for api.leadsfriday.com
#
# Lume dashboard (docs/lume/2026-10-14-lume-design.md)
# LUME_ACTION_SECRET=            X-Lume-Secret for Lume's POSTs into telegram-inbox; same value in lume/.env
# LUME_URL=                      Lume base URL, no trailing slash; empty skips the pending_actions execute call
#
# Lume's own Vercel env (lume/.env.example has the full list; see lume/README.md):
#   LUME_ALLOWED_EMAIL, LUME_ACTION_SECRET, LUME_HOOK_SECRET, LUME_INTERNAL_SECRET,
#   LUME_URL, INSTANTLY_WEBHOOK_SECRET, INSTANTLY_API_KEY, ANTHROPIC_API_KEY,
#   APIFY_API_TOKEN, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, ROTATE_CAMPAIGN_ID
# Supabase vault (SQL, not env): lume_url, lume_hook_secret, lume_owner_email
